{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Random Sutta",
  "version": "0.1.0",
  "identifier": "com.randomsutta.mac",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "npm run dev -- --port 8000",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Random Sutta",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "randomsutta"
        ]
      }
    }
  }
}

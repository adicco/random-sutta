{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Random Sutta",
  "version": "2026.0523.0628",
  "identifier": "com.randomsutta.mac",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "npm run dev -- --port 8000",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Random Sutta",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://accounts.google.com https://api.github.com; frame-src 'self'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "randomsutta",
          "com.googleusercontent.apps.103021460212-qk5ogq5es4dlpsmkf5a7q4h7nl7v9qle"
        ]
      }
    }
  }
}